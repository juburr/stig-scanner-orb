# orb.yml is "packed" from source, and not published directly from the repository.
orb.yml
.DS_Store

# Local-only working notes (planning docs, spike results, scratch).
# docs/planning/ is the exception: committed plans for work spanning
# several PRs. Its raw research notes and downloaded DISA files stay local.
docs/*
!docs/planning/
docs/planning/research_notes/
node_modules/
__pycache__/
